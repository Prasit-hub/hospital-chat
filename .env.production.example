# ===== ค่าสำหรับเซิร์ฟเวอร์จริง — คัดลอกเป็น .env.production แล้วแก้ทุกค่าที่มี <...> =====

# โดเมนที่ชี้มาที่เซิร์ฟเวอร์นี้ (ไม่ต้องใส่ https://) และอีเมลสำหรับแจ้งเตือนใบรับรอง HTTPS
DOMAIN=<chat.yourshop.com>
ACME_EMAIL=<you@yourshop.com>
PUBLIC_BASE_URL=https://<chat.yourshop.com>

# ฐานข้อมูล (สร้างอัตโนมัติใน Docker) — รหัสผ่านสุ่มด้วย: openssl rand -hex 24
POSTGRES_USER=hospchat
POSTGRES_PASSWORD=<รหัสผ่านยาวๆ>
POSTGRES_DB=hospchat
BACKUP_KEEP_DAYS=14

# คีย์เข้ารหัส token ช่องทาง: openssl rand -base64 32  (ห้ามเปลี่ยน/ห้ามหาย — เก็บสำรองไว้ที่ปลอดภัย)
ENCRYPTION_KEY=<base64 32 ไบต์>

# Meta (Facebook Messenger + Instagram)
META_APP_SECRET=<App Secret>
META_VERIFY_TOKEN=<ตั้งเองเป็นข้อความสุ่ม>
META_GRAPH_VERSION=v23.0
META_HUMAN_AGENT_TAG=false

# ส่งข้อความออกจริง
OUTBOUND_MODE=live
NEXT_PUBLIC_APP_TZ=Asia/Bangkok

# ตรวจอีเมลเข้าทุกกี่วินาที (ช่องทางอีเมล)
EMAIL_POLL_SECONDS=60
